"""Cliente mínimo de la API de $nombre: autenticación y el sobre de errores."""

from __future__ import annotations

from omnisocial.adapters.providers.$id.config import $const, ${clase}Config
from omnisocial.adapters.providers.$id.spec import ERRORS
from omnisocial.network import HttpResponse, HttpTransport, Params

_CLIENT_ERROR = 400


def as_dict(value: object) -> dict[str, object]:
    return value if isinstance(value, dict) else {}


def as_str(value: object) -> str | None:
    return value if isinstance(value, str) and value else None


class ${clase}Client:
    def __init__(self, config: ${clase}Config, transport: HttpTransport) -> None:
        self._config = config
        self._transport = transport

    @property
    def config(self) -> ${clase}Config:
        return self._config

    @property
    def transport(self) -> HttpTransport:
        return self._transport

    async def get(self, path: str, token: str, params: Params | None = None) -> dict[str, object]:
        response = await self._transport.request(
            "GET",
            f"{self._config.api_base}/{path.lstrip('/')}",
            params=params,
            headers={"Authorization": f"Bearer {token}"},
        )
        return self._unwrap(response)

    @staticmethod
    def _unwrap(response: HttpResponse) -> dict[str, object]:
        """PENDIENTE: el sobre de errores real. Acá se supone `{"error": {"code": ..., "message": ...}}`."""
        body = as_dict(response.data)
        if response.status < _CLIENT_ERROR and "error" not in body:
            return body
        error = as_dict(body.get("error"))
        message = as_str(error.get("message")) or response.text[:300] or f"HTTP {response.status}"
        raise ERRORS.error(
            $const,
            message,
            status=response.status,
            code=as_str(error.get("code")),
            retry_after=response.retry_after(),
        )
